# Copy to .env (git-ignored) in the directory you run marginalia from. Real environment variables win over this file.
# Every secret also has a *_FILE twin holding a path to a file with the value (use one or the other, not both).

# Where the database (db/) and the raw pages (blobs/) live.
MARGINALIA_DATA=./data

# Listen address of `marginalia serve`. Default 127.0.0.1:7878. Either set MARGINALIA_BIND ...
#MARGINALIA_BIND=127.0.0.1:7878
# ... or HOST and/or PORT (used when MARGINALIA_BIND is not set).
#HOST=127.0.0.1
#PORT=7878

# Bearer token for REST and /mcp. Empty means no auth: only acceptable on loopback.
MARGINALIA_TOKEN=
#MARGINALIA_TOKEN_FILE=/run/secrets/marginalia-token

# Any OpenAI-compatible chat API. Examples:
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com      LLM_MODEL=deepseek-chat
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<provider/model>
# Without an API key the built-in agent is off (chat, analyse and brief answer 503).
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
#LLM_API_KEY_FILE=/run/secrets/llm-api-key

# Optional. Without it, articles are extracted locally with dom_smoothie (Readability port).
FIRECRAWL_API_KEY=
#FIRECRAWL_API_KEY_FILE=/run/secrets/firecrawl-api-key
