# Any OpenAI-compatible chat API. Examples:
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com      LLM_MODEL=deepseek-chat
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<provider/model>
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional. Without it, articles are extracted locally with dom_smoothie (Readability port).
FIRECRAWL_API_KEY=

# Where saved articles live (one Markdown file each).
LIBRARY_DIR=./library
