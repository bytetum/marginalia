node_modules/
src-tauri/target/
src-tauri/gen/schemas/
# gen/android and gen/apple are generated by `tauri android init` / `tauri ios init` and committed (they carry our
# manifest, signing and share-extension changes); their own .gitignore files cover the build output.
src-tauri/gen/apple/build/
src-tauri/gen/apple/Externals/
src-tauri/gen/apple/*.xcodeproj/xcuserdata/
*.keystore
*.jks
