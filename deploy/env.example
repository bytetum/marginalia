# Copy to ~/.config/marginalia/env and chmod 600.
MARGINALIA_BIND=100.103.153.13:7878
# Public base URL, if served behind a proxy such as a Tailscale Service; marginalia-kb-sync uses it for reader links.
#MARGINALIA_URL=https://marginalia-bytetum.taild98079.ts.net
MARGINALIA_TOKEN=
# Behind `tailscale serve`: listen on a Unix socket in a 0700 directory (instead of MARGINALIA_BIND; setting both is an error)
# and let your own devices in with no token. tailscaled adds Tailscale-User-Login for personal devices only; it is trusted
# on a socket only, never on TCP. Tagged devices and programs on the server keep using the token.
#MARGINALIA_SOCKET=/run/user/1000/marginalia/m.sock
#MARGINALIA_TAILSCALE_LOGINS=bytetum@github
# Or keep the secrets in files: MARGINALIA_TOKEN_FILE, LLM_API_KEY_FILE, FIRECRAWL_API_KEY_FILE (path, not the value).

# Any OpenAI-compatible chat API. Without LLM_API_KEY the built-in agent is off (chat, analyse, brief return 503).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional. Without it, pages are extracted locally (Readability).
FIRECRAWL_API_KEY=
